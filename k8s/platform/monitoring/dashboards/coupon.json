  {
   "type": "timeseries",
   "title": "컨테이너 메모리 = 힙 + 힙 밖 + 네이티브",
   "description": "네이티브 = 스레드 스택, GC 자료구조, JIT 컴파일러, malloc. 6단계 실측: 힙 밖 약 186MB, 네이티브 약 100MB로 일정하고 차이는 힙 확보량에서 났다",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"apps\", container=\"coupon\"})",
     "legendFormat": "컨테이너 {{pod}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (pod) (jvm_memory_committed_bytes{job=\"coupon\", area=\"heap\"})",
     "legendFormat": "힙 확보 {{pod}}"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (pod) (jvm_memory_committed_bytes{job=\"coupon\", area=\"nonheap\"})",
     "legendFormat": "힙 밖 확보 {{pod}}"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"apps\", container=\"coupon\"}) - sum by (pod) (jvm_memory_committed_bytes{job=\"coupon\"})",
     "legendFormat": "JVM이 모르는 네이티브 {{pod}}"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max(container_spec_memory_limit_bytes{namespace=\"apps\", container=\"coupon\"})",
     "legendFormat": "limit"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
