     "expr": "sum(container_memory_working_set_bytes{node=~\"worker.*\"}) / sum(node_memory_MemTotal_bytes{node=~\"worker.*\"})",
     "legendFormat": "실제 사용(working set)"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   }
