    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(container_spec_memory_limit_bytes{node=~\"worker.*\"}) / sum(node_memory_MemTotal_bytes{node=~\"worker.*\"})",
     "legendFormat": "limit 합"
