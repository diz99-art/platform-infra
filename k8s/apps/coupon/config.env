# 쿠폰 서버 설정 (비밀이 아닌 값만). 비밀번호는 Secret mysql-coupon, redis에서 받는다 (Ansible이 vault로 만든다).
# Spring은 환경변수 이름을 설정 키로 바꿔 읽는다 (relaxed binding): SPRINGDOC_SWAGGER_UI_ENABLED → springdoc.swagger-ui.enabled
SPRING_PROFILES_ACTIVE=prod
REDIS_HOST=redis.data.svc.cluster.local
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka.data.svc.cluster.local:9092
# 인증 서버의 공개키 목록(JWKS). 클러스터 안 주소로 받는다 (Ingress를 거치지 않음). 토큰 검증은 이 공개키로만 한다
COUPON_AUTH_JWK_SET_URI=http://auth.apps.svc.cluster.local/auth/.well-known/jwks.json
# prod 프로필 기본값은 3(브로커 3대 기준). 우리 Kafka는 1대
KAFKA_REPLICATION_FACTOR=1
# prod 프로필은 API 문서를 끈다. 학습용 클러스터라 켠다 (실제 운영이라면 끄거나 인증 뒤에 둔다)
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
# 파드 하나의 DB 커넥션 풀. (replicas 2 + 배포 중 maxSurge 1) × 10 = 30 ≤ MySQL coupon 계정 상한 35
# 바꾸면 ansible/roles/mysql/defaults/main.yml의 mysql_service_max_connections_overrides도 고친다
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# 힙 = limit 640Mi의 40% = 256MB, Metaspace 상한, 스레드 스택, OOM이면 바로 종료, 서울 시각 (docs/coupon.md)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=40 -XX:MaxMetaspaceSize=192m -Xss512k -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Seoul
