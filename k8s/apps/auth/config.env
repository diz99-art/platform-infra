# 인증 서버 설정 (비밀이 아닌 값만). 비밀번호·개인키는 Secret mysql-auth, redis, auth-admin, auth-jwt-keys (Ansible)
SPRING_PROFILES_ACTIVE=prod
REDIS_HOST=redis.data.svc.cluster.local
REDIS_PORT=6379
# 서명 키 폴더(Secret 마운트)와 지금 서명에 쓰는 키 id. 키 교체 2단계에서 이 값을 새 kid로 바꾼다 (platform-services의 docs/auth.md)
AUTH_JWT_KEYS_DIR=/etc/auth/keys
AUTH_JWT_ACTIVE_KID=2026-10-20
# 커넥션 풀: (replicas 2 + maxSurge 1) × 10 = 30 ≤ MySQL auth 계정 상한 35
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# Swagger: 학습용 클러스터라 켠다 (/auth/swagger-ui.html)
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
# 힙 160MB 고정(부하 때 힙 사용 최대 약 75MB의 2배), Metaspace 상한, 스레드 스택, OOM이면 바로 종료, 서울 시각 (limit 512Mi, docs/memory-plan.md)
JAVA_TOOL_OPTIONS=-Xmx160m -XX:MaxMetaspaceSize=192m -Xss512k -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Seoul
