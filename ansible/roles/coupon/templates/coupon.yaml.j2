# 쿠폰 서버: Deployment(2대) + Service + PodDisruptionBudget + Ingress
# 상태는 MySQL·Redis·Kafka에 있고 서버 자체는 상태가 없으므로 Deployment로 충분하다 (MySQL은 StatefulSet)

apiVersion: apps/v1
kind: Deployment
metadata:
  name: coupon
  namespace: {{ coupon_namespace }}
  labels:
    app: coupon
spec:
  replicas: {{ coupon_replicas }}
  selector:
    matchLabels:
      app: coupon
  # 새 버전으로 바꿀 때: 새 파드를 하나 먼저 띄우고(maxSurge 1) Ready가 되면 옛 파드를 하나 내린다 (maxUnavailable 0)
  # → 배포 중에도 항상 2대가 요청을 받는다
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: coupon
      annotations:
        platform-infra/config-hash: "{{ lookup('template', 'config.yaml.j2') | hash('sha256') | truncate(16, True, '') }}"
    spec:
      # 2대를 서로 다른 노드에 둔다. 노드 하나가 죽어도 1대는 살아 있게.
      # ScheduleAnyway: 노드가 하나뿐인 상황(점검 중)에도 일단 띄운다 (DoNotSchedule이면 Pending으로 남는다)
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: coupon
      enableServiceLinks: false
      # preStop 10초 + Spring graceful shutdown(최대 30초) + 여유
      terminationGracePeriodSeconds: 45
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ coupon_uid }}
      containers:
        - name: coupon
          image: {{ coupon_image_repo }}:{{ coupon_image_tag }}
          ports:
            - name: http
              containerPort: 8080
            - name: management
              containerPort: 8081
          envFrom:
            - configMapRef:
                name: coupon-config
          env:
            # 3단계에서 Ansible이 vault 값으로 만든 Secret을 그대로 쓴다
            - name: DB_HOST
              valueFrom: { secretKeyRef: { name: mysql-coupon, key: host } }
            - name: DB_NAME
              valueFrom: { secretKeyRef: { name: mysql-coupon, key: database } }
            - name: DB_USERNAME
              valueFrom: { secretKeyRef: { name: mysql-coupon, key: username } }
            - name: DB_PASSWORD
              valueFrom: { secretKeyRef: { name: mysql-coupon, key: password } }
            - name: REDIS_PASSWORD
              valueFrom: { secretKeyRef: { name: redis, key: password } }
          resources:
            requests:
              cpu: {{ coupon_cpu_request }}
              memory: {{ coupon_memory_request }}
            # CPU limit 없음: JVM은 시작할 때 CPU를 많이 쓴다. limit이 있으면 시작이 몇 배 느려진다
            limits:
              memory: {{ coupon_memory_limit }}
          # Actuator 헬스 체크 (관리 포트 8081, Service로는 열지 않음)
          # 시작(스프링 컨텍스트 + DB·Redis·Kafka 연결)이 끝날 때까지 최대 3분 기다린다
          startupProbe:
            httpGet: { path: /actuator/health/liveness, port: management }
            periodSeconds: 5
            failureThreshold: 36
          # liveness: 앱 자체가 살아 있나. DB·Redis가 죽었다고 앱을 재시작해 봐야 소용없으므로 외부 의존성은 보지 않는다
          livenessProbe:
            httpGet: { path: /actuator/health/liveness, port: management }
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          # readiness: 요청을 받을 준비가 됐나. 시작 중이거나 종료 중이면 Service에서 빠진다
          readinessProbe:
            httpGet: { path: /actuator/health/readiness, port: management }
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
          lifecycle:
            # 종료 신호 전에 10초 기다린다: 그 사이 Service·Traefik이 이 파드를 목록에서 빼서 새 요청이 오지 않게 된다
            # (없으면 이미 종료 중인 파드로 요청이 가서 502가 난다)
            preStop:
              sleep:
                seconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: coupon
  namespace: {{ coupon_namespace }}
spec:
  selector:
    app: coupon
  ports:
    - name: http
      port: 80
      targetPort: http
---
# 점검(kubectl drain) 때도 최소 1대는 남긴다. 2대를 한꺼번에 내리는 요청은 기다리게 된다
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: coupon
  namespace: {{ coupon_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: coupon
---
# 맥 브라우저 → 노드 IP:80 → Traefik → coupon:80
# 지금은 쿠폰 서버가 유일한 앱이라 / 전체를 받는다. Gateway가 생기면 Gateway가 / 를 받고 쿠폰은 Gateway 뒤로 들어간다
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: coupon
  namespace: {{ coupon_namespace }}
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: coupon
                port:
                  name: http
