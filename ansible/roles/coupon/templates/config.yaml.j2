# 쿠폰 서버 설정 (비밀이 아닌 값만). 비밀번호는 Secret mysql-coupon, redis에서 받는다.
# Spring은 환경변수 이름을 설정 키로 바꿔 읽는다 (relaxed binding): SPRINGDOC_SWAGGER_UI_ENABLED → springdoc.swagger-ui.enabled
apiVersion: v1
kind: ConfigMap
metadata:
  name: coupon-config
  namespace: {{ coupon_namespace }}
data:
  SPRING_PROFILES_ACTIVE: prod
  REDIS_HOST: {{ coupon_redis_host }}
  REDIS_PORT: "6379"
  KAFKA_BOOTSTRAP_SERVERS: {{ coupon_kafka_bootstrap }}
  # prod 프로필 기본값은 3(브로커 3대 기준). 우리 Kafka는 1대
  KAFKA_REPLICATION_FACTOR: "1"
  # prod 프로필은 API 문서를 끈다. 학습용 클러스터라 켠다 (실제 운영이라면 끄거나 인증 뒤에 둔다)
  SPRINGDOC_API_DOCS_ENABLED: "true"
  SPRINGDOC_SWAGGER_UI_ENABLED: "true"
  # 파드 하나의 DB 커넥션 풀 크기 (HikariCP 기본값과 같지만, MySQL 계정의 연결 상한 35와 짝이라 명시한다)
  # (replicas 2 + 배포 중 maxSurge 1) × 10 = 30 ≤ 35. 바꾸면 mysql 롤의 mysql_service_max_connections_overrides도 고친다
  SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE: "{{ coupon_db_pool_size }}"
  JAVA_TOOL_OPTIONS: "{{ coupon_java_opts }}"
