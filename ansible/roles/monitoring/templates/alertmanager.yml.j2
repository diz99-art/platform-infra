{# Alertmanager 설정. 디스코드 웹훅 주소가 들어 있어 Secret으로만 만든다 (Git에 없음). #}
{# {% raw %} 안은 Alertmanager(Go 템플릿)가 읽는 부분이라 Jinja가 건드리지 않게 감싼다. #}
global:
  resolve_timeout: 5m

route:
  receiver: {{ 'discord' if discord_webhook_url else 'blackhole' }}
  # 같은 알림 이름·네임스페이스끼리 묶어서 한 메시지로
  group_by: [alertname, namespace]
  group_wait: 30s       # 처음 울릴 때 30초 모아서 보낸다
  group_interval: 5m    # 같은 묶음에 새 알림이 생기면 5분 뒤 다시
  repeat_interval: 4h   # 계속 울리는 중이면 4시간마다 다시 알림

receivers:
  # 웹훅이 아직 없을 때: 알림을 받아만 두고 어디로도 보내지 않는다 (http://<노드IP>/alertmanager 에서는 보인다)
  - name: blackhole
{% if discord_webhook_url %}
  - name: discord
    discord_configs:
      - webhook_url: '{{ discord_webhook_url }}'
        send_resolved: true
{% raw %}
        title: '[{{ .Status | toUpper }}{{ if eq .Status "firing" }} {{ len .Alerts.Firing }}건{{ end }}] {{ .CommonLabels.alertname }}'
        message: |-
          {{ range .Alerts }}• {{ .Annotations.summary }}
            {{ .Annotations.description }}
          {{ end }}
{% endraw %}
{% endif %}
